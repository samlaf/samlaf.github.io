    {
      "id": "an-hNGHrpHEuQTKuYAfEJ",
      "type": "text",
      "x": -3073.142071400393,
      "y": 1596.1731600539674,
      "width": 699.71142578125,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 454213411,
      "version": 123,
      "versionNonce": 1998834765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "Client History Perspective; considered under asynchronous model.\nBailis' HAT paper mentions:\nWeakened failure assumptions as in escrow or in the form of bounded network asynchrony\ncould enable richer HAT semantics at the cost of general-purpose availability.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client History Perspective; considered under asynchronous model.\nBailis' HAT paper mentions:\nWeakened failure assumptions as in escrow or in the form of bounded network asynchrony\ncould enable richer HAT semantics at the cost of general-purpose availability.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119237,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "GlupITI0gb0sus7FEOnei",
      "type": "text",
      "x": -2203.230011078472,
      "y": 1536.076016465805,
      "width": 734.0477905273438,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 1163190979,
      "version": 238,
      "versionNonce": 1460120323,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "Consensus (single-shot) / SMR (small subset of RDS)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consensus (single-shot) / SMR (small subset of RDS)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119237,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "DwNo26dKhTpyMJx5cciyA",
      "type": "text",
      "x": -2463.3166567811286,
      "y": 1944.7801795515684,
      "width": 251.07176208496094,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 382833251,
      "version": 72,
      "versionNonce": 1054784173,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "Note that CAP is a bit of \nan odd bird because it's safety \nis that of SMR, not agreement.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note that CAP is a bit of \nan odd bird because it's safety \nis that of SMR, not agreement.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119237,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e6mgw60hDHzVsU78YvHBa",
