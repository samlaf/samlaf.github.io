    },
    {
      "id": "D5V0SVjanKTZ7Xuv5OobG",
      "type": "text",
      "x": -2714.2569932259958,
      "y": 1736.6479170581115,
      "width": 505.0715637207031,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 1135077699,
      "version": 310,
      "versionNonce": 94701123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "Relevant for all sorts of distributed objects, even those weaker\nthan universal (aka don't solve consensus), like:\nregisters (abd), chain replication, stack/queue, etc.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relevant for all sorts of distributed objects, even those weaker\nthan universal (aka don't solve consensus), like:\nregisters (abd), chain replication, stack/queue, etc.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119237,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "yhqOvzkbEL1jD2FCJtlNR",
      "type": "text",
      "x": 2905.1308407563242,
      "y": 1959.102359495304,
      "width": 1305.16357421875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1O",
      "roundness": null,
      "seed": 301975779,
      "version": 168,
      "versionNonce": 1472705389,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "How / for what is this consensus protocol used?\n1. elect new leader (needed in PBFT, but not in tendermint with fixed leader rotation schedule)\n2. ??",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How / for what is this consensus protocol used?\n1. elect new leader (needed in PBFT, but not in tendermint with fixed leader rotation schedule)\n2. ??",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119237,
      "labelPosition": null,
      "baseFontSize": null
    },
