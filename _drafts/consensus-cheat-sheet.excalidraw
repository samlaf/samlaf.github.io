    },
    {
      "id": "UGlVIQxdLmCNO3lq0NKK2",
      "type": "text",
      "x": -1584.768765732299,
      "y": 204.98528615746443,
      "width": 522.9755249023438,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1067284067,
      "version": 403,
      "versionNonce": 1224419501,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "Note that wait-freedom coordination is much harder via IPC/RPC!!\n-IPC: kernel can forget to reschedule you\n-RPC: no idea how long msg delivery will take\n\nThis is why CAS feels magical: process never gives control to\nnetwork or kernel; remains in cpu+memory safe space",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note that wait-freedom coordination is much harder via IPC/RPC!!\n-IPC: kernel can forget to reschedule you\n-RPC: no idea how long msg delivery will take\n\nThis is why CAS feels magical: process never gives control to\nnetwork or kernel; remains in cpu+memory safe space",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794525119236,
      "labelPosition": null,
      "baseFontSize": null
    },
