    {
      "id": "NuG75pItxo2bnCyo2WbW7",
      "type": "text",
      "x": -2849.9005617961257,
      "y": 217.27826824679948,
      "width": 395.8425562984025,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 147301155,
      "version": 427,
      "versionNonce": 934672973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "text": "the key is that writing here can either be done:\n- without coordination (lock-free stuff, etc)\n- using coordination (either using IPC or using\nsome synchronization primitive implemented using\nshared metadata memory + CAS/mutex)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the key is that writing here can either be done:\n- without coordination (lock-free stuff, etc)\n- using coordination (either using IPC or using some synchronization primitive implemented using shared metadata memory + CAS/mutex)",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1794525119236,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "xTohQLOzSctRqoSKdX65H",
      "type": "arrow",
      "x": -1612.3739622749154,
      "y": 240.66409272443764,
      "width": 162.61435412775882,
      "height": 0.24433790292414415,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": {
        "type": 2
      },
      "seed": 1926055619,
      "version": 147,
      "versionNonce": 1115118851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794525119239,
      "link": null,
      "locked": false,
      "points": [
        [
          0,
          0
        ],
        [
          -162.61435412775882,
          -0.24433790292414415
