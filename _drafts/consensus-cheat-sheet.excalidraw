      "type": "text",
      "x": -870.4979774781857,
      "y": 1676.8219662194592,
      "width": 92.35191345214844,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
